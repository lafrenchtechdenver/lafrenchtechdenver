---
/**
 * Single source of truth for every page's <head>, global CSS import, theme
 * bootstrap, skip-link, nav, main landmark, and footer. All six pages render
 * their unique content into this layout's default <slot>.
 *
 * DOM order is load-bearing for accessibility: the skip-link is the first
 * focusable element on every page (placed BEFORE <Nav> so the nav's
 * outside-click handler does not capture clicks meant for the link), and the
 * skip-link target `<main id="main-content">` wraps the page slot. See
 * `project_wiki/architecture/accessibility.md` for the full WCAG 2.2 AA
 * baseline this layout establishes.
 *
 * Meta defaults mirror the legacy inline <head>: OpenGraph + Twitter cards
 * pointing at the Logo_FT_Denver image, favicon at /assets/favicon.ico.
 */
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'La French Tech Denver',
  description = 'French Tech Community Denver connects founders, tech talent, VCs, corporates and public partners between France and Colorado.',
  ogImage = 'https://lafrenchtechdenver.com/assets/logos/Logo_FT_Denver.png',
} = Astro.props;

// Astro.url.pathname is the source-route path ("/index.html", "/about.html", ...).
// Passed through to Nav so the matching menu link gets the `.active` style.
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Theme bootstrap. Runs synchronously in <head> before <body> parses, so the
      `data-theme` attribute is correct on first paint and there is no flash of
      unstyled theme when a dark-mode user reloads. Keep this as a tiny inline
      script — moving it to the ThemeToggle component would delay execution
      until after paint and reintroduce the FOUC. See
      `instructions/keep_theme_bootstrap_inline_in_head.md`.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme') || 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    {/*
      Skip-to-content link. MUST stay BEFORE <Nav> in DOM order so:
      1. A keyboard user pressing Tab once lands on it.
      2. The Nav's outside-click handler (which closes the mobile menu when a
         click happens outside `.nav`) does not swallow Enter/click events on
         the skip-link.
    */}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
