---
/**
 * Sticky top navigation shared by every page.
 *
 * Milestone 2 split the theme toggle and social block out into their own
 * components — `ThemeToggle.astro` owns the toggle button + click handler,
 * and `SocialLinks.astro` owns the LinkedIn / Facebook / mailto trio. This
 * Nav component now focuses on the menu items and the burger / outside-click
 * behavior.
 *
 * The `currentPath` prop (e.g. "/", "/about.html") is used to apply the
 * `.active` class to the matching menu entry. Treat `/` and `/index.html` as
 * equivalent so the Home link remains highlighted whether the user landed via
 * the bare domain or the full filename.
 */
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const menuItems: Array<{ href: string; label: string }> = [
  { href: '/index.html', label: 'Home' },
  { href: '/about.html', label: 'About us' },
  { href: '/companies-sponsors.html', label: 'Companies & Sponsors' },
  { href: '/members-benefits.html', label: 'Members Benefits' },
  { href: '/events.html', label: 'Events' },
  { href: '/resources.html', label: 'Resources' },
];

function isActive(href: string): boolean {
  if (href === '/index.html') {
    return currentPath === '/' || currentPath === '/index.html';
  }
  return currentPath === href;
}
---

<header class="nav">
  <div class="container nav-inner">
    <div class="logo">
      <img
        src="/assets/logos/Logo_FT_Denver.png"
        alt="La French Tech Denver logo"
        style="height: 40px; width: auto;"
      />
      <span>La French Tech Denver</span>
    </div>
    <button
      class="burger"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="menu"
      id="burger-button"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="menu" id="menu">
      {menuItems.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
          {item.label}
        </a>
      ))}
      <SocialLinks />
      <ThemeToggle />
    </nav>
  </div>
</header>

<script is:inline>
  // Burger menu toggle + outside-click close. Kept inline so it runs without
  // bundler ceremony on every page and matches the legacy behavior 1:1.
  // The companion theme-toggle handler lives in ThemeToggle.astro.
  (function () {
    const burger = document.getElementById('burger-button');
    const menu = document.getElementById('menu');
    if (!burger || !menu) return;

    function setExpanded(open) {
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function toggleMenu() {
      const willOpen = !menu.classList.contains('active');
      menu.classList.toggle('active');
      burger.classList.toggle('active');
      setExpanded(willOpen);
    }

    burger.addEventListener('click', function (event) {
      // Stop the click from immediately reaching the document-level outside-click
      // handler below — that would close the menu we just opened.
      event.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', function (event) {
      if (!menu.classList.contains('active')) return;
      const nav = document.querySelector('.nav');
      if (nav && !nav.contains(event.target)) {
        menu.classList.remove('active');
        burger.classList.remove('active');
        setExpanded(false);
      }
    });
  })();
</script>
