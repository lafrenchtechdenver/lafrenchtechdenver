---
/**
 * Renders one board member as a `.card.person` block linking to their
 * LinkedIn profile (photo, name, and role are inside the anchor).
 *
 * Replaces the hand-coded `<div class="card person">…</div>` blocks that lived
 * in the legacy `about.html`. The grayscale treatment is now expressed via the
 * `is-grayscale` CSS class (declared in `src/styles/global.css`) instead of an
 * inline `style="filter: grayscale(100%)"` attribute, so the rule is themable
 * and easier to disable per-member via the `grayscale` frontmatter flag.
 *
 * Milestone 4 swaps the raw `<img src={photo.src}>` for Astro's `<Picture>`
 * component so the Sharp pipeline emits responsive `srcset`, AVIF/WebP, and
 * `loading="lazy"` automatically. The board portraits are rendered at a fixed
 * 120 × 120 size (the legacy round avatar) so we ask Sharp for that target —
 * Sharp still emits modern formats and a 2× variant for hidpi screens.
 *
 * `<Picture>` is used here (rather than `<Image>`) because we want both AVIF
 * and WebP variants emitted as `<source>` elements with a JPEG fallback;
 * Astro's `<Image>` only supports a single output format via its `format` prop.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  photo: ImageMetadata;
  linkedinUrl: string;
  grayscale?: boolean;
}

const { name, role, photo, linkedinUrl, grayscale = true } = Astro.props;

const personClass = ['card', 'person', grayscale ? 'is-grayscale' : ''].filter(Boolean).join(' ');
---

<a
  class={personClass}
  href={linkedinUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-testid="board-card"
>
  <Picture
    src={photo}
    alt={name}
    width={240}
    height={240}
    widths={[120, 240]}
    sizes="120px"
    loading="lazy"
    quality={75}
    formats={['avif', 'webp']}
  />
  <h4>{name}</h4>
  <div class="note">{role}</div>
</a>
