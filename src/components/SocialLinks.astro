---
/**
 * LinkedIn / Facebook / mailto block, used in the nav (and reusable in any
 * other page chrome that needs the social block).
 *
 * Milestone 3 wires this component to read from the `site` data collection
 * (`src/content/site/social.json`), eliminating the last copy of the social
 * URLs from component code. Props remain accepted as overrides — primarily
 * used by tests that want to assert against synthetic URLs without touching
 * the JSON file — but the defaults come from the collection so a single edit
 * to `site.json` updates every page.
 *
 * `currentColor` SVGs make the icons inherit the surrounding `.social-link`
 * text color, which the global stylesheet keys to `var(--text)` so the icons
 * stay legible in both light and dark themes.
 */
import { getEntry } from 'astro:content';

interface Props {
  linkedinUrl?: string;
  facebookUrl?: string;
  contactEmail?: string;
}

const siteEntry = await getEntry('site', 'social');
if (!siteEntry) {
  throw new Error(
    "SocialLinks: missing 'social' entry in the `site` data collection " +
      '(expected at src/content/site/social.json).',
  );
}

const {
  linkedinUrl = siteEntry.data.linkedinUrl,
  facebookUrl = siteEntry.data.facebookUrl,
  contactEmail = siteEntry.data.contactEmail,
} = Astro.props;

const mailtoHref = `mailto:${contactEmail}`;
---

<div class="social-links">
  <a
    href={linkedinUrl}
    target="_blank"
    rel="noopener"
    class="social-link"
    aria-label="LinkedIn"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
      ></path></svg
    >
  </a>
  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener"
    class="social-link"
    aria-label="Facebook"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
      ></path></svg
    >
  </a>
  <a href={mailtoHref} class="social-link" aria-label="Email">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M12 12.713l-11.985-9.713h23.97l-11.985 9.713zm0 2.574l-12-9.725v15.438h24v-15.438l-12 9.725z"
      ></path></svg
    >
  </a>
</div>
