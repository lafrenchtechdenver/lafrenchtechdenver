---
/**
 * LinkedIn / Facebook / Email block rendered inside the nav (and reusable
 * elsewhere — e.g., the footer in a future milestone).
 *
 * URLs are accepted as props with sensible defaults that match the current
 * site. In Milestone 3 the defaults will be replaced by lookups against
 * `src/content/site.json` so the URLs live in one canonical place; until that
 * collection lands, callers can still override via props if needed.
 */

interface Props {
  linkedinUrl?: string;
  facebookUrl?: string;
  contactEmail?: string;
}

const {
  linkedinUrl = 'https://www.linkedin.com/company/denver-french-tech',
  facebookUrl = 'https://www.facebook.com/groups/lafrenchtechdenver/',
  contactEmail = 'contact@lafrenchtechdenver.com',
} = Astro.props;

const mailtoHref = `mailto:${contactEmail}`;
---

<div class="social-links">
  <a
    href={linkedinUrl}
    target="_blank"
    rel="noopener"
    class="social-link"
    aria-label="LinkedIn"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
      ></path></svg
    >
  </a>
  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener"
    class="social-link"
    aria-label="Facebook"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
      ></path></svg
    >
  </a>
  <a href={mailtoHref} class="social-link" aria-label="Email">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M12 12.713l-11.985-9.713h23.97l-11.985 9.713zm0 2.574l-12-9.725v15.438h24v-15.438l-12 9.725z"
      ></path></svg
    >
  </a>
</div>
