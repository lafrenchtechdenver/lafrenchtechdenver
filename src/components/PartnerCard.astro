---
/**
 * Renders one partner / sponsor as a `.partner` block.
 *
 * The legacy markup wraps the logo + name + tagline in a single
 * `<a target="_blank" rel="noopener">`; that contract is preserved here so the
 * existing `.partner` styles in `src/styles/global.css` continue to apply.
 *
 * Milestone 4 swaps the raw `<img>` for Astro's `<Picture>` component so the
 * Sharp pipeline emits responsive `srcset`, AVIF/WebP, and `loading="lazy"`
 * automatically. Partner logos render at a fixed 120 × 120 box (with
 * `object-fit: contain` from the global stylesheet); Sharp emits 1× and 2×
 * variants so hidpi screens stay sharp without delivering full-resolution
 * source files.
 *
 * `<Picture>` is used here (rather than `<Image>`) because we want both AVIF
 * and WebP variants emitted as `<source>` elements with a fallback `<img>`;
 * Astro's `<Image>` only supports a single output format via its `format` prop.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  tagline: string;
  url: string;
  logo: ImageMetadata;
}

const { name, tagline, url, logo } = Astro.props;
---

<div class="partner" data-testid="partner-card">
  <a href={url} target="_blank" rel="noopener">
    <Picture
      src={logo}
      alt={`${name} logo`}
      width={240}
      height={240}
      widths={[120, 240]}
      sizes="120px"
      loading="lazy"
      quality={80}
      formats={['avif', 'webp']}
    />
    <div>
      <h4>{name}</h4>
      <div class="note">{tagline}</div>
    </div>
  </a>
</div>
