---
/**
 * Renders one partner / sponsor as a `.partner` block.
 *
 * The legacy markup wraps the logo + name + tagline in a single
 * `<a target="_blank" rel="noopener">`; that contract is preserved here so the
 * existing `.partner` styles in `src/styles/global.css` continue to apply.
 *
 * Like BoardCard, Milestone 3 keeps the logo as a raw `<img>` referencing
 * the resolved `.src` URL of the typed `ImageMetadata`. Milestone 4 swaps to
 * `<Image>` for the Sharp pipeline.
 */
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  tagline: string;
  url: string;
  logo: ImageMetadata;
}

const { name, tagline, url, logo } = Astro.props;
---

<div class="partner" data-testid="partner-card">
  <a href={url} target="_blank" rel="noopener">
    <img
      alt={`${name} logo`}
      src={logo.src}
      width={logo.width}
      height={logo.height}
    />
    <div>
      <h4>{name}</h4>
      <div class="note">{tagline}</div>
    </div>
  </a>
</div>
