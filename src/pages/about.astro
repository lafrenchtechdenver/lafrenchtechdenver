---
/**
 * `/about.html` — the real About page.
 *
 * Milestone 1 shipped a placeholder so the nav link did not 404. Milestone 3
 * replaces it with the full page:
 *   - hero (matches the legacy `about.html` lines 287–295)
 *   - mission + values cards (legacy lines 299–317)
 *   - "Meet the Board" grid driven by `getCollection('board')`, sorted by the
 *     frontmatter `order` field so the rendered sequence is deterministic
 *     across operating systems
 *
 * Photos are still referenced through raw `<img>` markup inside `BoardCard`
 * this milestone — Milestone 4 swaps to Astro's `<Image>` component so the
 * Sharp pipeline emits responsive `srcset` + AVIF/WebP. No frontmatter changes
 * are required for that swap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import BoardCard from '../components/BoardCard.astro';

const board = (await getCollection('board')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="About us — La French Tech Denver"
  description="About La French Tech Denver: our mission, values, and the volunteer board behind the community."
>
  <Hero
    title="About La French Tech Denver"
    subtitle="We are a curated support community helping entrepreneurs thrive through a strong network and shared best practices."
  />

  <div class="container">
    <div class="grid grid-2">
      <div class="card">
        <h2>Our Mission</h2>
        <p>
          Bring French entrepreneurs together, help develop startups, and support
          French-speaking tech players in the Denver/Boulder region. We connect French
          startups with investors and local tech leaders.
        </p>
        <h3>Goals</h3>
        <ul>
          <li>Support existing French startups in Colorado</li>
          <li>Grow an ecosystem where anyone can build in the Rockies</li>
          <li>Bridge the local tech scene with French founders and talent</li>
        </ul>
      </div>
      <div class="card">
        <h2>Our Values</h2>
        <ul>
          <li>Collaboration — Support &amp; Accelerate</li>
          <li>Innovation — Empower &amp; Federate</li>
          <li>Entrepreneurship — Inspire &amp; Shine</li>
        </ul>
      </div>
    </div>

    <div class="section">
      <h2>Meet the Board</h2>
      <div class="board">
        {board.map((member) => (
          <BoardCard
            name={member.data.name}
            role={member.data.role}
            photo={member.data.photo}
            grayscale={member.data.grayscale}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
