---
/**
 * Home page — hero, "What is La French Tech Denver" + Google Form CTA,
 * 4 KPI cards, and 6 home-featured Friends & Partners.
 *
 * Milestone 3 replaces the inline `kpis` and `partners` arrays from Milestone 1
 * with `getCollection(...)` calls against the new content collections, and
 * pulls the membership form URL from the `site` data collection so the URL
 * lives in exactly one file (`src/content/site/social.json`) rather than being
 * hard-coded on the page. Each KPI/partner is rendered through its dedicated
 * component (`KpiCard.astro`, `PartnerCard.astro`).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Hero from '../components/Hero.astro';
import KpiCard from '../components/KpiCard.astro';
import PartnerCard from '../components/PartnerCard.astro';

// KPIs: 4 separate entries under `src/content/kpis/*.json`. Sort by the
// `order` field so the displayed sequence is deterministic regardless of
// filesystem iteration order.
const kpis = (await getCollection('kpis')).sort((a, b) => a.data.order - b.data.order);

// Partners flagged for the home page via `featuredOn: ['home', ...]` in
// frontmatter. The same collection drives the sponsor grid on
// `/companies-sponsors.html` (Milestone 4) — single source of truth.
const homePartners = await getCollection('partners', (entry) =>
  entry.data.featuredOn.includes('home'),
);

const siteEntry = await getEntry('site', 'social');
if (!siteEntry) {
  throw new Error(
    "index.astro: missing 'social' entry in the `site` data collection " +
      '(expected at src/content/site/social.json).',
  );
}
const membershipFormUrl = siteEntry.data.membershipFormUrl;
---

<BaseLayout title="La French Tech Denver">
  <Hero
    title="La French Tech Denver"
    subtitle="Your tech rendez-vous with a French touch and mountain views"
  />

  <div class="container">
    <div class="section card">
      <h2>What is La French Tech Denver</h2>
      <p>
        French Tech Community Denver connects founders, tech talent, VCs, corporates and public
        partners between France and Colorado — to accelerate growth with a focus on positive social
        and environmental impact.
      </p>
      <p style="margin-top: 24px;">
        <a class="cta" href={membershipFormUrl} target="_blank" rel="noopener"> Become a Member </a>
      </p>
    </div>

    <div class="section kpis">
      {kpis.map((kpi) => <KpiCard value={kpi.data.value} label={kpi.data.label} />)}
    </div>

    <div class="section card">
      <h2>Friends & Partners</h2>
      <div class="grid grid-3">
        {
          homePartners.map((partner) => (
            <PartnerCard
              name={partner.data.name}
              tagline={partner.data.tagline}
              url={partner.data.url}
              logo={partner.data.logo}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
