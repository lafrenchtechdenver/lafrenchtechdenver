---
/**
 * Home page: hero, "What is La French Tech Denver" + Google Form CTA,
 * 4 KPIs, and 6 Friends & Partners.
 *
 * Milestone 1 keeps the content inline. Milestone 3 migrates the KPI and
 * partner lists into `src/content/*` collections; the structure of this
 * page will stay roughly the same — the inline arrays below will be
 * replaced with `await getCollection('kpis')` / `getCollection('partners')`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const kpis: Array<{ value: string; label: string }> = [
  { value: '13', label: 'Companies' },
  { value: '262', label: 'People' },
  { value: '5', label: 'Nationalities' },
  { value: '33%', label: 'Women' },
];

const partners: Array<{
  name: string;
  tagline: string;
  url: string;
  logo: string;
  alt: string;
}> = [
  {
    name: 'Superteam',
    tagline: 'Marketing & Events',
    url: 'https://superteam.ca',
    logo: '/assets/logos/superteam-canada.jpeg',
    alt: 'Superteam logo',
  },
  {
    name: 'Modelcode.ai',
    tagline: 'Software & AI',
    url: 'https://modelcode.ai',
    logo: '/assets/logos/modelcode-ai.jpg',
    alt: 'Modelcode.ai logo',
  },
  {
    name: 'Mad Science of Colorado',
    tagline: 'STEM Education',
    url: 'https://colorado.madscience.org',
    logo: '/assets/logos/mad-science-of-colorado.jpeg',
    alt: 'Mad Science of Colorado logo',
  },
  {
    name: 'Ridiculous Engineering',
    tagline: 'Engineering & Operations',
    url: 'https://ridiculousengineering.com',
    logo: '/assets/logos/ridiculous-engineering.jpeg',
    alt: 'Ridiculous Engineering logo',
  },
  {
    name: 'Einride',
    tagline: 'Autonomous Tech',
    url: 'https://einride.tech',
    logo: '/assets/logos/einride.jpeg',
    alt: 'Einride logo',
  },
  {
    name: 'Extern',
    tagline: 'Customer Success',
    url: 'https://www.extern.com',
    logo: '/assets/logos/externhq.jpeg',
    alt: 'Extern logo',
  },
];

const MEMBERSHIP_FORM_URL =
  'https://docs.google.com/forms/d/1tpHwjsberWYWbVuiEy9S6CP44k0gxJuaFi9ha5QBIqM/viewform';
---

<BaseLayout title="La French Tech Denver">
  <section class="hero">
    <div class="container">
      <h1>La French Tech Denver</h1>
      <p>Your tech rendez-vous with a French touch and mountain views</p>
    </div>
  </section>

  <div class="container">
    <div class="section card">
      <h2>What is La French Tech Denver</h2>
      <p>
        French Tech Community Denver connects founders, tech talent, VCs, corporates and public
        partners between France and Colorado — to accelerate growth with a focus on positive
        social and environmental impact.
      </p>
      <p style="margin-top: 24px;">
        <a class="cta" href={MEMBERSHIP_FORM_URL} target="_blank" rel="noopener">
          Become a Member
        </a>
      </p>
    </div>

    <div class="section kpis">
      {kpis.map((kpi) => (
        <div class="card kpi">
          <div class="num">{kpi.value}</div>
          <div class="label">{kpi.label}</div>
        </div>
      ))}
    </div>

    <div class="section card">
      <h2>Friends & Partners</h2>
      <div class="grid grid-3">
        {partners.map((partner) => (
          <div class="partner">
            <a href={partner.url} target="_blank" rel="noopener">
              <img alt={partner.alt} src={partner.logo} />
              <div>
                <h4>{partner.name}</h4>
                <div class="note">{partner.tagline}</div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
