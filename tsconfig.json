{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "jsx": "preserve"
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "src/**/*",
    "tests/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
